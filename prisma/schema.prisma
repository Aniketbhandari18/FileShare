// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  name String
  role Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records Record[] // records created by sender
  accesses RecordAccess[] // records accessed by receiver
}

model Record {
  id String @id @default(cuid())
  createdById String
  fileName String
  description String?
  category FileCategory @default(OTHER)

  fileKey String @unique
  password String?
  expiresAt DateTime
  isRevoked Boolean @default(false)

  orgFileName String // org file name that was uploaded
  uploadThingFileKey String @unique // uploadthing file key
  fileUrl String
  fileType String // from uploadthing. eg: application/pdf
  fileSize Int
  
  createdBy User @relation(fields: [createdById], references: [id])
  accesses RecordAccess[] // receivers who accessed this record

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecordAccess{
  id String @id @default(cuid())
  userId String
  recordId String
  accessedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  record Record @relation(fields: [recordId], references: [id])

  @@unique([recordId, userId])
}

enum Role {
  SENDER
  RECEIVER
}

enum FileCategory {
  DOCUMENTS
  IMAGES
  REPORTS
  ASSIGNMENTS
  PRESENTATIONS
  OTHER
}
